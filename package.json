{
  "name": "deep-ui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "examples/demo"
  ],
  "description": "Deep \u2014 a copy-in design system source template (tokens + shadcn/base-nova primitives)",
  "license": "MIT",
  "author": "Luke",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "shadcn",
    "base-ui",
    "ui-components",
    "design-tokens"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:tests": "node scripts/verify-tests.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:selectors": "node scripts/check-selectors.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run typecheck -w deep-ui-demo && npm run lint && npm test && npm run verify:tests && npm run check:tokens && npm run check:portable && npm run check:contrast && npm run check:selectors && npm run check:docs && npm run demo:build",
    "demo": "npm run dev -w deep-ui-demo",
    "demo:build": "npm run build -w deep-ui-demo",
    "size": "node scripts/measure-size.mjs"
  },
  "comment": "Not published. This package.json exists so the template can be type-checked standalone, and so it doubles as the exact dependency list a consuming app must install.",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  }
}
