{
  "name": "deep-ui",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "examples/demo"
  ],
  "description": "Deep — a copy-in design system source template (tokens + shadcn/base-nova primitives)",
  "license": "MIT",
  "author": "Luke",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "shadcn",
    "base-ui",
    "ui-components",
    "design-tokens"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "npm run dev -w demo",
    "demo:build": "npm run build -w demo"
  },
  "comment": "Not published. This package.json exists so the template can be type-checked standalone, and so it doubles as the exact dependency list a consuming app must install.",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
